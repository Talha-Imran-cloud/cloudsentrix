{
  "$schema": "https://schemastore.azurewebsites.net/schemas/json/sarif-2.1.0-rtm.5.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CloudSentrix",
          "version": "1.0.0",
          "informationUri": "https://github.com/Talha-Imran-cloud/cloudsentrix",
          "rules": [
            {
              "id": "GCP-002",
              "name": "ServiceAccountTokenCreator",
              "shortDescription": {
                "text": "Service Account Token Creator"
              },
              "fullDescription": {
                "text": "'app-backend@my-project.iam.gserviceaccount.com' holds 'roles/iam.serviceAccountTokenCreator' at project level, letting it mint short-lived access tokens for any service account in the project \u2014 effectively becoming that service account, no key required."
              },
              "helpUri": "https://attack.mitre.org/techniques/T1098/001/",
              "properties": {
                "tags": [
                  "security",
                  "gcp",
                  "iam",
                  "T1098.001"
                ],
                "precision": "high",
                "problem.severity": "critical"
              }
            },
            {
              "id": "GCP-004",
              "name": "IAMPolicyAdministrator",
              "shortDescription": {
                "text": "IAM Policy Administrator"
              },
              "fullDescription": {
                "text": "'admin@company.com' holds 'roles/owner', which can modify the project's IAM policy directly \u2014 including granting itself or any other principal additional roles."
              },
              "helpUri": "https://attack.mitre.org/techniques/T1098/003/",
              "properties": {
                "tags": [
                  "security",
                  "gcp",
                  "iam",
                  "T1098.003"
                ],
                "precision": "high",
                "problem.severity": "critical"
              }
            },
            {
              "id": "GCP-005",
              "name": "ServiceAccountImpersonationviaResourceAttach",
              "shortDescription": {
                "text": "Service Account Impersonation via Resource Attach"
              },
              "fullDescription": {
                "text": "'intern@company.com' holds 'roles/iam.serviceAccountUser' and can also create new resources via roles/editor. It can deploy a new resource (e.g. a VM or Cloud Function), attach a service account to it, and run as that service account."
              },
              "helpUri": "https://attack.mitre.org/techniques/T1548/005/",
              "properties": {
                "tags": [
                  "security",
                  "gcp",
                  "iam",
                  "T1548.005"
                ],
                "precision": "high",
                "problem.severity": "high"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "GCP-002",
          "level": "error",
          "message": {
            "text": "'app-backend@my-project.iam.gserviceaccount.com' holds 'roles/iam.serviceAccountTokenCreator' at project level, letting it mint short-lived access tokens for any service account in the project \u2014 effectively becoming that service account, no key required."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "name": "app-backend@my-project.iam.gserviceaccount.com",
                  "kind": "gcp/iam/principal"
                }
              ]
            }
          ],
          "properties": {
            "severity": "CRITICAL",
            "mitre": "T1098.001 \u2014 Account Manipulation: Additional Cloud Credentials",
            "evidence": [
              "roles/iam.serviceAccountTokenCreator"
            ]
          }
        },
        {
          "ruleId": "GCP-004",
          "level": "error",
          "message": {
            "text": "'admin@company.com' holds 'roles/owner', which can modify the project's IAM policy directly \u2014 including granting itself or any other principal additional roles."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "name": "admin@company.com",
                  "kind": "gcp/iam/principal"
                }
              ]
            }
          ],
          "properties": {
            "severity": "CRITICAL",
            "mitre": "T1098.003 \u2014 Account Manipulation: Additional Cloud Roles",
            "evidence": [
              "roles/owner"
            ]
          }
        },
        {
          "ruleId": "GCP-005",
          "level": "error",
          "message": {
            "text": "'intern@company.com' holds 'roles/iam.serviceAccountUser' and can also create new resources via roles/editor. It can deploy a new resource (e.g. a VM or Cloud Function), attach a service account to it, and run as that service account."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "name": "intern@company.com",
                  "kind": "gcp/iam/principal"
                }
              ]
            }
          ],
          "properties": {
            "severity": "HIGH",
            "mitre": "T1548.005 \u2014 Abuse Elevation Control Mechanism: Temporary Elevated Cloud Access",
            "evidence": [
              "roles/iam.serviceAccountUser",
              "roles/editor"
            ]
          }
        }
      ],
      "properties": {
        "securityScore": 35,
        "securityRating": "Poor",
        "sourceFile": "sample_data/sample_gcp_iam.json"
      }
    }
  ]
}